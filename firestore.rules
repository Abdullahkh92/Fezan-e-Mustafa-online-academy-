rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Academy Inquiries & Admissions
    match /inquiries/{inquiryId} {
      allow get, update, delete: if isValidId(inquiryId);
      allow create: if isValidId(inquiryId) && request.resource.data.studentName is string && request.resource.data.whatsapp is string;
      allow list: if true;
    }

    // Website Visitor Traffic Analytics
    match /traffic_visits/{visitId} {
      allow get, update, delete: if isValidId(visitId);
      allow create: if isValidId(visitId) && request.resource.data.visitorId is string && request.resource.data.page is string;
      allow list: if true;
    }

    // Bank Payment Submissions & Verification
    match /payments/{paymentId} {
      allow get, update, delete: if isValidId(paymentId);
      allow create: if isValidId(paymentId) && request.resource.data.customerName is string && request.resource.data.amount is string;
      allow list: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
