{
  "entities": {
    "Inquiry": {
      "title": "Academy Inquiry & Admission",
      "description": "Student admissions, free-trial bookings, and contact inquiries for Faizan-e-Mustafa Online Academy",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "type": {
          "type": "string",
          "enum": ["free_trial", "admission", "inquiry", "contact"],
          "description": "Type of inquiry"
        },
        "studentName": {
          "type": "string",
          "description": "Full name of the student"
        },
        "parentName": {
          "type": "string",
          "description": "Parent or guardian name"
        },
        "age": {
          "type": "string",
          "description": "Age of the student"
        },
        "country": {
          "type": "string",
          "description": "Country of residence"
        },
        "whatsapp": {
          "type": "string",
          "description": "WhatsApp contact number with country code"
        },
        "email": {
          "type": "string",
          "description": "Email address"
        },
        "course": {
          "type": "string",
          "description": "Selected Quran or Islamic studies course"
        },
        "timing": {
          "type": "string",
          "description": "Preferred class timing"
        },
        "genderPreference": {
          "type": "string",
          "description": "Teacher gender preference (Any, Male Teacher, Female Teacher)"
        },
        "message": {
          "type": "string",
          "description": "Inquiry details, prior knowledge, or specific requests"
        },
        "status": {
          "type": "string",
          "enum": ["New", "Contacted", "Enrolled", "Completed"],
          "description": "Current workflow state"
        },
        "isDemo": {
          "type": "boolean",
          "description": "Flag to distinguish development sample data from real production submissions"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp"
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal administrative follow-up notes"
        }
      },
      "required": ["studentName", "whatsapp", "status", "createdAt"]
    },
    "TrafficVisit": {
      "title": "Website Traffic Visit",
      "description": "Anonymous analytics visit event recorded for website usage and visitor trend tracking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique event identifier"
        },
        "visitorId": {
          "type": "string",
          "description": "Anonymous unique visitor identifier"
        },
        "sessionId": {
          "type": "string",
          "description": "Anonymous session identifier"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp"
        },
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD date"
        },
        "page": {
          "type": "string",
          "description": "Visited route or page section"
        },
        "referrer": {
          "type": "string",
          "description": "Referrer source or direct"
        },
        "deviceType": {
          "type": "string",
          "enum": ["Desktop", "Mobile", "Tablet"],
          "description": "Detected device category"
        },
        "browser": {
          "type": "string",
          "description": "Browser name"
        },
        "os": {
          "type": "string",
          "description": "Operating system"
        },
        "country": {
          "type": "string",
          "description": "Country if detected"
        },
        "isNewVisitor": {
          "type": "boolean",
          "description": "Whether this visit was the visitor's first recorded visit"
        }
      },
      "required": ["id", "visitorId", "timestamp", "date", "page"]
    },
    "PaymentRecord": {
      "title": "Payment Record",
      "description": "Student tuition fee payments via JazzCash and Easypaisa",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique payment record ID"
        },
        "userId": {
          "type": "string",
          "description": "Unique student/user identifier"
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the paying student/parent"
        },
        "mobileNumber": {
          "type": "string",
          "description": "Payer mobile number"
        },
        "amount": {
          "type": "number",
          "description": "Amount in PKR (minimum PKR 100, no maximum limit)"
        },
        "currency": {
          "type": "string",
          "description": "Payment currency code (PKR)"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["JazzCash", "Easypaisa"],
          "description": "Selected payment method"
        },
        "transactionId": {
          "type": "string",
          "description": "Unique Transaction ID or Reference Number from JazzCash/Easypaisa"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Approved", "Rejected"],
          "description": "Payment status"
        },
        "rejectionReason": {
          "type": "string",
          "description": "Reason for rejection if payment is rejected"
        },
        "verifiedAt": {
          "type": "string",
          "description": "Timestamp when approved or rejected"
        },
        "verifiedBy": {
          "type": "string",
          "description": "Admin username or API engine that verified payment"
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal administrative notes"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp"
        }
      },
      "required": ["id", "userId", "customerName", "mobileNumber", "amount", "paymentMethod", "transactionId", "status", "createdAt"]
    },
    "PaymentNotification": {
      "title": "Payment Notification",
      "description": "Real-time backend notification records for users and administrators",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique notification ID"
        },
        "recipientType": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "Target recipient type"
        },
        "userId": {
          "type": "string",
          "description": "Associated user identifier"
        },
        "paymentId": {
          "type": "string",
          "description": "Associated payment record ID"
        },
        "title": {
          "type": "string",
          "description": "Notification title"
        },
        "message": {
          "type": "string",
          "description": "Detailed notification message"
        },
        "read": {
          "type": "boolean",
          "description": "Whether the notification was read"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp"
        }
      },
      "required": ["id", "recipientType", "title", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Collection of all academy student admissions, trial requests, and inquiries"
    },
    "/traffic_visits/{visitId}": {
      "schema": "TrafficVisit",
      "description": "Collection of recorded anonymous visitor traffic logs for admin analytics"
    },
    "/payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Collection of student fee payments via JazzCash and Easypaisa"
    },
    "/payment_notifications/{notificationId}": {
      "schema": "PaymentNotification",
      "description": "Collection of real database-backed notifications for admin and users"
    }
  }
}
