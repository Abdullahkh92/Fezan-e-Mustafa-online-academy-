# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Academy Administrator Credentials
# Set these in your deployment environment / secrets to secure your portal
ADMIN_USERNAME="abdullah"
ADMIN_PASSWORD="Abdullah786"
ADMIN_SESSION_SECRET="faizan-e-mustafa-academy-session-auth-secret-key-2026"

# =========================================================================
# Official Mobile Payment Gateway Configuration (JazzCash / Easypaisa / Raast)
# =========================================================================
# Modes: "sandbox" (Test Mode) or "live" (Live Production Mode)
PAYMENT_GATEWAY_MODE="sandbox"
# Active Provider: "jazzcash" | "easypaisa" | "raast_mobile"
PAYMENT_GATEWAY_PROVIDER="jazzcash"
# Official Merchant Credentials (Kept strictly server-side, never exposed to client)
PAYMENT_GATEWAY_MERCHANT_ID="MC_TEST_109283"
PAYMENT_GATEWAY_PASSWORD="TEST_PASSWORD_SECRET"
PAYMENT_GATEWAY_INTEGRITY_SALT="TEST_INTEGRITY_SALT_SECRET"
PAYMENT_GATEWAY_API_URL="https://sandbox.jazzcash.com.pk/ApplicationAPI/API/2.0/Purchase/DoMWalletTransaction"
# Optional SMS / OTP Webhook Verification Secret
PAYMENT_WEBHOOK_SECRET="fma-payment-webhook-secret-token-2026"

